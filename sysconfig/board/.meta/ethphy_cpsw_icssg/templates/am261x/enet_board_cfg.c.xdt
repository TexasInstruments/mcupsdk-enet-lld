%%{
    let cpsw_instance = system.modules["/networking/enet_cpsw/enet_cpsw"].$instances[0];
    let cpswScript = system.getScript("/networking/enet_cpsw/enet_cpsw");
    let ethphyScript = system.getScript("/board/ethphy_cpsw_icssg/ethphy_cpsw_icssg");
%%}
% let common = system.getScript("/common");
% let device = common.getDeviceName();

% if (cpsw_instance.customBoardEnable === false) {
% let module = system.modules["/board/ethphy_cpsw_icssg/ethphy_cpsw_icssg"];
% let instances = module.$instances;
% let uniqueDevices = ethphyScript.getUniqueLinkedEthphy(module);
% let linkedInstances = ethphyScript.getLinkedInstances(module);
/* ========================================================================== */
/*                             Include Files                                  */
/* ========================================================================== */

#include <stdint.h>
#include <enet.h>
% for (let phyDevice of uniqueDevices) {
#include "`phyDevice.toLowerCase()`.h"
% }
#include <enet_apputils.h>
#include <enet_appboardutils.h>
#include <drivers/hw_include/cslr_soc.h>
#include <networking/enet/core/src/phy/enetphy_priv.h>
#include <generic_phy.h>
#include "ti_board_open_close.h"
#include <kernel/dpl/AddrTranslateP.h>
#include <board/ioexp/ioexp_tca6408.h>

/* PHY drivers */
% if(linkedInstances.length > 0) {
% for (let phyDevice of uniqueDevices){
extern Phy_DrvObj_t gEnetPhyDrv`common.camelSentence(phyDevice)`;
%}
extern Phy_DrvObj_t gEnetPhyDrvGeneric;
%}

/*! \brief All the registered PHY specific drivers. */
static const EthPhyDrv_If gEnetPhyDrvs[] =
{
% if(linkedInstances.length > 0) {
% for (let phyDevice of uniqueDevices){
    &gEnetPhyDrv`common.camelSentence(phyDevice)`,    /* `phyDevice` */
%}
    &gEnetPhyDrvGeneric,    /* Generic PHY - must be last */
%}
};

const EnetPhy_DrvInfoTbl gEnetPhyDrvTbl =
{
    .numHandles = ENET_ARRAYSIZE(gEnetPhyDrvs),
    .hPhyDrvList = gEnetPhyDrvs,
};

/* ========================================================================== */
/*                           Macros & Typedefs                                */
/* ========================================================================== */

/**
   TPR:MSS_CTRL:CPSW_CONTROL

   Address offset    0x0000016C
   Physical address  0x0212016C
   Instance          MSS_CTRL
   CPSW_CONTROL_RGMII1_ID_MODE     16  Writing 1'b1 would disable the internal clock delays. And those delays need to be handled on board.
   CPSW_CONTROL_RMII_REF_CLK_OE_N  8   To select the rmii_ref_clk from PAD or from MSS_RCM. 0: clock will be from mss_rcm through IO internal loopback 1: will be from
   CPSW_CONTROL_PORT1_MODE_SEL     2:0 Port 1 Interface
                                         00 = GMII/MII
                                         01 = RMII
                                         10 = RGMII
                                         11 = Not Supported
*/

#define MSS_CPSW_CONTROL_PORT_MODE_MII                                    (0x0U)
#define MSS_CPSW_CONTROL_PORT_MODE_RMII                                   (0x1U)
#define MSS_CPSW_CONTROL_PORT_MODE_RGMII                                  (0x2U)

#define I2C_EEPROM_DATATYPE_MAC_OFFSET                                    (0x38)
#define I2C_EEPROM_DATATYPE_MAC                                           (0x13)

#define I2C_EEPROM_MAC_DATA_OFFSET                                        (I2C_EEPROM_DATATYPE_MAC_OFFSET + 0x5)
#define I2C_EEPROM_MAC_CTRL_OFFSET                                        (0x3B)

#define ENET_BOARD_NUM_MACADDR_MAX                                        (3U)
#define ENET_GET_NUM_MAC_ADDR(num)                                        ((num>>3)+1)
#define ENET_MAC_ADDR_VALIDATE_MASK                                       (0x01U)

#define I2C_ADDRESS_IO_EXPANDER0_TCA6408                                  (0x20U)
#define I2C_ADDRESS_IO_EXPANDER1_TCA6408                                  (0x21U)

#define EEPROM_OFFSET_READ_PCB_REV                                        (0x0022U)
#define EEPROM_READ_PCB_REV_DATA_LEN                                      (0x2U)

#define I2C_EEPROM_IS_MAC_ADDR_VALID(mac)                                 (((mac)[0]|(mac)[1]|(mac)[2]|(mac)[3]|(mac)[4]|(mac)[5]) != 0)
/* ========================================================================== */
/*                         Structure Declarations                             */
/* ========================================================================== */

/* None */

/* ========================================================================== */
/*                          Function Declarations                             */
/* ========================================================================== */

/* None */

/* ========================================================================== */
/*                            Global Variables                                */
/* ========================================================================== */

% for (let idx of linkedInstances) {
/*!
 * \brief Common Processor Board (CPB) board's `instances[idx].phySelect` PHY configuration.
 */
% let phyName = (instances[idx].phySelect == "CUSTOM")? (instances[idx].customDeviceName) : (instances[idx].phySelect);
static const `common.camelSentence(phyName)`_Cfg gEnetCpbBoard_`common.camelSentence(instances[idx].$name)`PhyCfg =
{
    % if(instances[idx].skipExtendedConfig == false) {
    `instances[idx].extendedConfig`
    % }
};
%}

/*
 * `device` board configuration.
 *
 * RMII/RGMII PHY connected to `device` CPSW_3G MAC port.
 */
static const EnetBoard_PortCfg gEnetCpbBoard_`device.replace('-','_')`_EthPort[] =
{
% for (let idx of linkedInstances) {
    {    /* "CPSW3G" */
        .enetType = ENET_CPSW_3G,
        .instId   = 0U,
        .macPort  = `instances[idx].peripheral.replace("CPSW", "ENET")`,
% let portName = instances[idx].peripheral
% let portNumber = Number(portName[portName.length - 1])
        .mii      = {`cpswScript.getMiiConfig(cpsw_instance, portNumber - 1).layerType`, `cpswScript.getMiiConfig(cpsw_instance, portNumber - 1).sublayerType`},
        .phyCfg   =
        {
            .phyAddr         = `instances[idx].phyAddr`,
            .isStrapped      = `instances[idx].isStrappedPhy`,
            .skipExtendedCfg = `instances[idx].skipExtendedConfig`,
			.extendedCfg     = &gEnetCpbBoard_`common.camelSentence(instances[idx].$name)`PhyCfg,
			.extendedCfgSize = sizeof(gEnetCpbBoard_`common.camelSentence(instances[idx].$name)`PhyCfg)
        },
        .flags    = 0U,
    },
%}
};

/* ========================================================================== */
/*                          Function Definitions                              */
/* ========================================================================== */

const EnetBoard_PhyCfg *EnetBoard_getPhyCfg(const EnetBoard_EthPort *ethPort)
{
    const EnetBoard_PortCfg *portCfg;

    portCfg = EnetBoard_getPortCfg(ethPort);

    return (portCfg != NULL) ? &portCfg->phyCfg : NULL;
}

void EnetBoard_enableExternalMux()
{
    /* Enable external MUXes, if any, as per the board design */
}

const EnetBoard_PortCfg *EnetBoard_getPortCfg(const EnetBoard_EthPort *ethPort)
{
    const EnetBoard_PortCfg *portCfg = NULL;

    if (ENET_NOT_ZERO(ethPort->boardId & ENETBOARD_CPB_ID) ||
    ((portCfg == NULL) && ENET_NOT_ZERO(ethPort->boardId & ENETBOARD_LOOPBACK_ID)))
    {
        portCfg = EnetBoard_findPortCfg(ethPort,
                                        gEnetCpbBoard_`device.replace('-','_')`_EthPort,
                                        ENETPHY_ARRAYSIZE(gEnetCpbBoard_`device.replace('-','_')`_EthPort));

    }
    return portCfg;
}

const EnetBoard_PortCfg *EnetBoard_findPortCfg(const EnetBoard_EthPort *ethPort,
                                                      const EnetBoard_PortCfg *ethPortCfgs,
                                                      uint32_t numEthPorts)
{
    const EnetBoard_PortCfg *ethPortCfg = NULL;
    bool found = false;
    uint32_t i;

    for (i = 0U; i < numEthPorts; i++)
    {
        ethPortCfg = &ethPortCfgs[i];

        if ((ethPortCfg->enetType == ethPort->enetType) &&
            (ethPortCfg->instId == ethPort->instId) &&
            (ethPortCfg->macPort == ethPort->macPort) &&
            (ethPortCfg->mii.layerType == ethPort->mii.layerType) &&
            (ethPortCfg->mii.sublayerType == ethPort->mii.sublayerType))
        {
            found = true;
            break;
        }
    }

    return found ? ethPortCfg : NULL;
}

void EnetBoard_getMiiConfig(EnetMacPort_Interface *mii, const Enet_MacPort macPort)
{
    switch(macPort){
%let cp_info = cpswScript.getCpswInstInfo(cpsw_instance); 
%let macPortList = cp_info.macPortList
%for (const macPort of macPortList){
        case `macPort`:
%   let interfaceMode = (macPort == 'ENET_MAC_PORT_1') ? cpsw_instance.phyToMacInterfaceMode1 : cpsw_instance.phyToMacInterfaceMode2;
%   if (interfaceMode == "RGMII") {
            mii->layerType      = ENET_MAC_LAYER_GMII;
            mii->variantType    = ENET_MAC_VARIANT_FORCED;
            mii->sublayerType   = ENET_MAC_SUBLAYER_REDUCED;
%   } else if (interfaceMode == "RMII") {
            mii->layerType      = ENET_MAC_LAYER_MII;
            mii->variantType  = ENET_MAC_VARIANT_NONE;
            mii->sublayerType   = ENET_MAC_SUBLAYER_REDUCED;
%   } else if (interfaceMode == "MII") {
            mii->layerType      = ENET_MAC_LAYER_MII;
            mii->variantType  = ENET_MAC_VARIANT_NONE;
            mii->sublayerType   = ENET_MAC_SUBLAYER_STANDARD;
%   }
            break;
%}
        default:
            break;
    }
}

int32_t EnetBoard_setupPorts(EnetBoard_EthPort *ethPorts,
                             uint32_t numEthPorts)
{
    CSL_mss_ctrlRegs *mssCtrlRegs = (CSL_mss_ctrlRegs *)CSL_MSS_CTRL_U_BASE;

    DebugP_assert(numEthPorts == 1);

    EnetBoard_enableExternalMux();

    SOC_controlModuleUnlockMMR(SOC_DOMAIN_ID_MAIN, MSS_CTRL_PARTITION0);
    switch(ethPorts->macPort)
    {
        case ENET_MAC_PORT_1:
%if (cpsw_instance.phyToMacInterfaceMode1 == "RGMII") {
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_RGMII1_ID_MODE, `Number(cpsw_instance.enableRgmiiIntDelay1)`U);
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_PORT1_MODE_SEL, MSS_CPSW_CONTROL_PORT_MODE_RGMII);
% } else if (cpsw_instance.phyToMacInterfaceMode1 == "RMII") {
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_PORT1_MODE_SEL, MSS_CPSW_CONTROL_PORT_MODE_RMII);
%} else if (cpsw_instance.phyToMacInterfaceMode1 == "MII") {
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_PORT1_MODE_SEL, MSS_CPSW_CONTROL_PORT_MODE_MII);
%}
%if (cpsw_instance.BoardType === "am261x-lp"){
            EnetBoard_setMacPort1IOExpanderCfg();
%}
            break;
        case ENET_MAC_PORT_2:
%if (cpsw_instance.phyToMacInterfaceMode2 == "RGMII") {
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_RGMII2_ID_MODE, `Number(cpsw_instance.enableRgmiiIntDelay2)`U);
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_PORT2_MODE_SEL, MSS_CPSW_CONTROL_PORT_MODE_RGMII);
% } else if (cpsw_instance.phyToMacInterfaceMode2 == "RMII") {
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_PORT2_MODE_SEL, MSS_CPSW_CONTROL_PORT_MODE_RMII);
%} else if (cpsw_instance.phyToMacInterfaceMode2 == "MII") {
            CSL_FINS( mssCtrlRegs->CPSW_CONTROL,MSS_CTRL_CPSW_CONTROL_PORT2_MODE_SEL, MSS_CPSW_CONTROL_PORT_MODE_MII);
%}
%if (cpsw_instance.BoardType === "am261x-lp"){
            EnetBoard_setMacPort2IOExpanderCfg();
%}
            break;
        default:
            DebugP_assert(false);
    }
    SOC_controlModuleLockMMR(SOC_DOMAIN_ID_MAIN, MSS_CTRL_PARTITION0);
    
    /* Nothing else to do */
    return ENET_SOK;
}

%if (cpsw_instance.BoardType === "am261x-lp"){
static void EnetBoard_enableLevelTranslator(void)
{
    TCA6408_Config  gTCA6408_Config;
    TCA6408_Params      TCA6408Params;
    int32_t status    = ENET_SOK;
    TCA6408_Params_init(&TCA6408Params);

    TCA6408Params.i2cAddress  = I2C_ADDRESS_IO_EXPANDER0_TCA6408;

    status = TCA6408_open(&gTCA6408_Config, &TCA6408Params);
    EnetAppUtils_assert(status == ENET_SOK);

    if (status == ENET_SOK)
    {
        /* Configure as output  */
        status = TCA6408_config(&gTCA6408_Config,
                                4,
                                TCA6408_MODE_OUTPUT);
       EnetAppUtils_assert(status == ENET_SOK);
    }

    if (status == ENET_SOK)
    {
        status =  TCA6408_setOutput(&gTCA6408_Config, 4, TCA6408_OUT_STATE_HIGH);
        EnetAppUtils_assert(status == ENET_SOK);
    }
}

void EnetBoard_setMacPort1IOExpanderCfg(void)
{
    TCA6408_Config  gTCA6408_Config;
    TCA6408_Params      TCA6408Params;
    int32_t status    = ENET_SOK;
    uint8_t boardVer[EEPROM_READ_PCB_REV_DATA_LEN] = "";

    status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0], EEPROM_OFFSET_READ_PCB_REV, boardVer, EEPROM_READ_PCB_REV_DATA_LEN);
    EnetAppUtils_assert(status == ENET_SOK);

    /* Syscfg board version is used on when Eeprom is not programmed(0xFF)  */
    if ((boardVer[1] == 0xFF) && (boardVer[0] == 0xFF))
    {
        boardVer[1] = '1';
        boardVer[0] = 'E';
        EnetAppUtils_print("Assuming Board Version as E1\r\n");
    }

    if(status == ENET_SOK)
    {
    if(((boardVer[1] == '2') && (boardVer[0] == 'E')) || ((boardVer[1] == 0) && (boardVer[0] == 'A')))
    {
        /* board version is or Rev-A */
        EnetBoard_enableLevelTranslator();
    }
    }
    EnetAppUtils_assert(status == ENET_SOK);


    TCA6408_Params_init(&TCA6408Params);
    TCA6408Params.i2cAddress  = I2C_ADDRESS_IO_EXPANDER1_TCA6408;

    status = TCA6408_open(&gTCA6408_Config, &TCA6408Params);
    EnetAppUtils_assert(status == ENET_SOK);

    if (status == ENET_SOK)
    {
        /* Configure as output  */
        status = TCA6408_config(&gTCA6408_Config,
                                4,
                                TCA6408_MODE_OUTPUT);
        EnetAppUtils_assert(status == ENET_SOK);
    }

    if (status == ENET_SOK)
    {
        if(boardVer[1] == '2' && boardVer[0] == 'E')
        {
            /* board Version is E2 */
            status =  TCA6408_setOutput(&gTCA6408_Config, 4, TCA6408_OUT_STATE_LOW);
            EnetAppUtils_assert(status == ENET_SOK);
        }
        else if(boardVer[1] == '1' && boardVer[0] == 'E')
        {
            /* board Version is E1 */
            status =  TCA6408_setOutput(&gTCA6408_Config, 4, TCA6408_OUT_STATE_HIGH);
            EnetAppUtils_assert(status == ENET_SOK);
        }
        else if(boardVer[1] == 0 && boardVer[0] == 'A')
        {
            /* board Version is Rev-A */
            status =  TCA6408_setOutput(&gTCA6408_Config, 3, TCA6408_OUT_STATE_LOW);
            EnetAppUtils_assert(status == ENET_SOK);
        }
    }
}

void EnetBoard_setMacPort2IOExpanderCfg(void)
{
    TCA6408_Config  gTCA6408_Config;
    TCA6408_Params      TCA6408Params;
    int32_t status    = ENET_SOK;
    uint8_t boardVer[EEPROM_READ_PCB_REV_DATA_LEN] = "";

    status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0], EEPROM_OFFSET_READ_PCB_REV, boardVer, EEPROM_READ_PCB_REV_DATA_LEN);

    /* Syscfg board version is used on when Eeprom is not programmed(0xFF)  */
    if ((boardVer[1] == 0xFF) && (boardVer[0] == 0xFF))
    {
        boardVer[1] = '1';
        boardVer[0] = 'E';
        EnetAppUtils_print("Assuming Board Version as E1\r\n");
    }

    if(status == ENET_SOK)
    {
        if(((boardVer[1] == '2') && (boardVer[0] == 'E')) || ((boardVer[1] == 0) && (boardVer[0] == 'A')))
        {
            /* board Version is E2 or Rev-A */
            EnetBoard_enableLevelTranslator();
        }
    }
    DebugP_assert(status == ENET_SOK);
    TCA6408_Params_init(&TCA6408Params);
    TCA6408Params.i2cAddress  = I2C_ADDRESS_IO_EXPANDER1_TCA6408;

    status = TCA6408_open(&gTCA6408_Config, &TCA6408Params);
    EnetAppUtils_assert(status == ENET_SOK);

    if (status == ENET_SOK)
    {
        /* Configure as output  */
        status = TCA6408_config(&gTCA6408_Config,
                                3,
                                TCA6408_MODE_OUTPUT);
        EnetAppUtils_assert(status == ENET_SOK);
    }

    if (status == ENET_SOK)
    {
        status =  TCA6408_setOutput(&gTCA6408_Config, 3, TCA6408_OUT_STATE_LOW);
        EnetAppUtils_assert(status == ENET_SOK);
    }
}
%}

%if (cpsw_instance.BoardType === "am261x-lp"){
void EnetBoard_getMacAddrList(uint8_t macAddr[][ENET_MAC_ADDR_LEN],
                              uint32_t maxMacEntries,
                              uint32_t *pAvailMacEntries)
{
    int32_t status = ENET_SOK;
    uint32_t macAddrCnt = 0U;
    uint32_t i;
    uint8_t numMacMax;
    uint8_t macAddrBufRevA[ENET_BOARD_NUM_MACADDR_MAX * ENET_MAC_ADDR_LEN];
    uint8_t validNumMac = 0U;
    uint8_t boardVer[EEPROM_READ_PCB_REV_DATA_LEN] = "";

    /* One Mac address is programmed in each EEPROM for E1/E2 version */
    uint32_t eepromInstanceArray[ENET_BOARD_NUM_MACADDR_MAX];
    uint32_t eepromInstanceCount = 0U;
    uint8_t typeWord = 0U;
    uint8_t macAddrBuf[ENET_MAC_ADDR_LEN];
    uint32_t eepromInstance = 0U;

    status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0], EEPROM_OFFSET_READ_PCB_REV, boardVer, EEPROM_READ_PCB_REV_DATA_LEN);
    EnetAppUtils_assert(status == ENET_SOK);

    if ((boardVer[1] == 0) && (boardVer[0] == 'A'))
    {
        status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0],  I2C_EEPROM_MAC_CTRL_OFFSET, &numMacMax, sizeof(uint8_t));
        EnetAppUtils_assert(status == ENET_SOK);
        EnetAppUtils_assert(ENET_GET_NUM_MAC_ADDR(numMacMax) <= ENET_BOARD_NUM_MACADDR_MAX);
        EnetAppUtils_assert(pAvailMacEntries != NULL);

        macAddrCnt = EnetUtils_min(ENET_GET_NUM_MAC_ADDR(numMacMax), maxMacEntries);

        status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0], I2C_EEPROM_MAC_DATA_OFFSET, macAddrBufRevA, (macAddrCnt * ENET_MAC_ADDR_LEN) );
        EnetAppUtils_assert(status == ENET_SOK);

        /* Save only those required to meet the max number of MAC entries */
        /* Validating that the MAC addresses from the EEPROM are not MULTICAST addresses */
        for (i = 0U; i < macAddrCnt; i++)
        {
            if(!(macAddrBufRevA[i * ENET_MAC_ADDR_LEN] & ENET_MAC_ADDR_VALIDATE_MASK)){
                memcpy(macAddr[validNumMac], &macAddrBufRevA[i * ENET_MAC_ADDR_LEN], ENET_MAC_ADDR_LEN);
                validNumMac++;
            }
        }
    }
    else
    {
        #ifdef CONFIG_EEPROM_PORT1
        eepromInstanceArray[eepromInstanceCount] = CONFIG_EEPROM_PORT1;
        eepromInstanceCount += 1U;
        #endif

        #ifdef CONFIG_EEPROM_PORT2
        eepromInstanceArray[eepromInstanceCount] = CONFIG_EEPROM_PORT2;
        eepromInstanceCount += 1U;
        #endif

        /* There is one MAC Address in Each EEPROM.
           take number of mac reads as min(eepromInstanceCount, maxMacEntries) */
        eepromInstanceCount = EnetUtils_min(eepromInstanceCount, maxMacEntries);

        for (int32_t eepromIndex = 0U; eepromIndex < eepromInstanceCount; eepromIndex++)
        {
            eepromInstance = eepromInstanceArray[eepromIndex];

            /* Check the mac address type word. */
            typeWord = 0;
            status = EEPROM_read(gEepromHandle[eepromInstance], I2C_EEPROM_DATATYPE_MAC_OFFSET,
                                 &typeWord, sizeof(typeWord));

            if (status != SystemP_SUCCESS)
            {
                EnetAppUtils_print("Unable to read from eeprom instance number %d\r\n", eepromInstance);
                continue;
            }
            if (typeWord != I2C_EEPROM_DATATYPE_MAC)
            {
                EnetAppUtils_print("MAC is not fused in eeprom instance number %d, Invalid typeword %02X\r\n", eepromInstance, (int)typeWord);
                continue;
           }

            /* Both read EEPROM and typeword check is success.
               Now, read MAC Address from EEPROM. */
            status = EEPROM_read(gEepromHandle[eepromInstance], I2C_EEPROM_MAC_DATA_OFFSET,
                                                            macAddrBuf, sizeof(macAddrBuf));
            if (status != SystemP_SUCCESS)
            {
                EnetAppUtils_print("Unable to read from eeprom instance number %d\r\n", eepromInstance);
                continue;
            }

            /* Validate the MAC Addresses. */
            if (!I2C_EEPROM_IS_MAC_ADDR_VALID(macAddrBuf))
            {
                EnetAppUtils_print("Invalid MAC Address from eeprom instance number %d\r\n", eepromInstance);
                continue;
            }
            if(!(macAddrBuf[0U] & ENET_MAC_ADDR_VALIDATE_MASK))
            {
                /* Copy the MAC address to the output buffer */
                memcpy(macAddr[validNumMac], macAddrBuf, ENET_MAC_ADDR_LEN);
                validNumMac++;
            }
        }
        macAddrCnt = EnetUtils_min(validNumMac, maxMacEntries);
    }

    *pAvailMacEntries = validNumMac;

    if (macAddrCnt == 0U)
    {
        EnetAppUtils_print("EnetBoard_getMacAddrList Failed - IDK not present\n");
        EnetAppUtils_assert(false);
    }
}
% } else if (cpsw_instance.BoardType === "am261x-som"){
void EnetBoard_getMacAddrList(uint8_t macAddr[][ENET_MAC_ADDR_LEN],
                              uint32_t maxMacEntries,
                              uint32_t *pAvailMacEntries)
{
    int32_t status = ENET_SOK;
    uint32_t macAddrCnt;
    uint32_t i;
    uint8_t numMacMax;
    uint8_t macAddrBuf[ENET_BOARD_NUM_MACADDR_MAX * ENET_MAC_ADDR_LEN];
    uint8_t validNumMac = 0U;

    status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0],  I2C_EEPROM_MAC_CTRL_OFFSET, &numMacMax, sizeof(uint8_t));
    EnetAppUtils_assert(status == ENET_SOK);
    EnetAppUtils_assert(ENET_GET_NUM_MAC_ADDR(numMacMax) <= ENET_BOARD_NUM_MACADDR_MAX);
    EnetAppUtils_assert(pAvailMacEntries != NULL);

    macAddrCnt = EnetUtils_min(ENET_GET_NUM_MAC_ADDR(numMacMax), maxMacEntries);

    status = EEPROM_read(gEepromHandle[CONFIG_EEPROM0], I2C_EEPROM_MAC_DATA_OFFSET, macAddrBuf, (macAddrCnt * ENET_MAC_ADDR_LEN) );
    EnetAppUtils_assert(status == ENET_SOK);

    /* Save only those required to meet the max number of MAC entries */
    /* Validating that the MAC addresses from the EEPROM are not MULTICAST addresses */
    for (i = 0U; i < macAddrCnt; i++)
    {
        if(!(macAddrBuf[i * ENET_MAC_ADDR_LEN] & ENET_MAC_ADDR_VALIDATE_MASK)){
            memcpy(macAddr[validNumMac], &macAddrBuf[i * ENET_MAC_ADDR_LEN], ENET_MAC_ADDR_LEN);
            validNumMac++;
        }
    }

    *pAvailMacEntries = validNumMac;

    if (macAddrCnt == 0U)
    {
        EnetAppUtils_print("EnetBoard_getMacAddrList Failed - IDK not present\n");
        EnetAppUtils_assert(false);
    }
}
%}

/*
 * Get ethernet board id
 */
uint32_t EnetBoard_getId(void)
{
    return ENETBOARD_AM261X_EVM;
}

% }
