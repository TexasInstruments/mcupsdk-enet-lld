%%{
    let cpsw_instance = system.modules["/networking/enet_cpsw/enet_cpsw"].$instances[0];
    let cpswScript = system.getScript("/networking/enet_cpsw/enet_cpsw");
    let ethphyScript = system.getScript("/board/ethphy_cpsw_icssg/ethphy_cpsw_icssg");

    /* Helper function to map interface mode to MII configuration */
    function getInterfaceMiiConfig(interfaceMode) {
        if (interfaceMode === "RMII") {
            return { layer: "ENET_MAC_LAYER_MII", sublayer: "ENET_MAC_SUBLAYER_REDUCED" };
        } else if (interfaceMode === "RGMII") {
            return { layer: "ENET_MAC_LAYER_GMII", sublayer: "ENET_MAC_SUBLAYER_REDUCED" };
        } else if (interfaceMode === "SGMII") {
            return { layer: "ENET_MAC_LAYER_GMII", sublayer: "ENET_MAC_SUBLAYER_SERIAL" };
        } else {
            /* Default to GMII/REDUCED for unknown modes */
            return { layer: "ENET_MAC_LAYER_GMII", sublayer: "ENET_MAC_SUBLAYER_REDUCED" };
        }
    }

    /* Get the MAC port for a given PHY instance */
    function getMacPortForPhyInstance(phyInstance) {
        /* Map peripheral name (CPSW1, CPSW2) to MAC port */
        if (phyInstance.peripheral === "CPSW1") {
            return "ENET_MAC_PORT_1";
        } else if (phyInstance.peripheral === "CPSW2") {
            return "ENET_MAC_PORT_2";
        }
        return null;
    }

    /* Get interface mode for a given MAC port from SysConfig */
    function getInterfaceModeForPort(macPort) {
        if (macPort === "ENET_MAC_PORT_1") {
            return cpsw_instance.phyToMacInterfaceMode1;
        } else if (macPort === "ENET_MAC_PORT_2") {
            return cpsw_instance.phyToMacInterfaceMode2;
        }
        return "RGMII"; /* Default */
    }
%%}
