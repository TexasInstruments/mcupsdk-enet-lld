                                     Enet_MacPort macPort,
                                     EnetMacPort_Interface *mii)
{

}

void EnetBoard_getMacAddrList(uint8_t macAddr[][ENET_MAC_ADDR_LEN],
                              uint32_t maxMacEntries,
                              uint32_t *pAvailMacEntries)
{
    /* For AM62D-EVM, the MAC Addresses are programmed on the Addon cards.
    Check if the EEPROM Instances are added, if yes, read from those instances. */
    int32_t status;
    /* One Mac address is programmed in each EEPROM. */
    uint32_t eepromInstanceArray[ENET_BOARD_NUM_MACADDR_MAX];
    uint32_t eepromInstanceCount = 0;

#ifdef RGMII1_EEPROM
    eepromInstanceArray[eepromInstanceCount] = RGMII1_EEPROM;
    eepromInstanceCount += 1;
#endif

#ifdef RGMII2_EEPROM
    eepromInstanceArray[eepromInstanceCount] = RGMII2_EEPROM;
    eepromInstanceCount += 1;
#endif

    /* There is one MAC Address in Each EEPROM.
    take number of mac reads as min(eepromInstanceCount, maxMacEntries) */
    eepromInstanceCount = EnetUtils_min(eepromInstanceCount, maxMacEntries);

    /* To keep track of number of filled addresses. */
    uint32_t macFilledCount = 0;

    for (int i = 0; i < eepromInstanceCount; i++)
    {
        EnetAppUtils_print("EEPROM %d MAC addr: ", i);
        uint8_t macAddrBuf[ENET_MAC_ADDR_LEN];
        uint32_t eepromInstance = eepromInstanceArray[i];

        /* Check the mac address type word. */
        uint8_t typeWord = 0;
        status = EEPROM_read(gEepromHandle[eepromInstance], EEPROM_DATATYPE_MAC_OFFSET,
                             &typeWord, sizeof(typeWord));

        if (status != SystemP_SUCCESS)
        {
            EnetAppUtils_print("Unable to read from eeprom instance number %d\r\n", eepromInstance);
            continue;
        }

        if (typeWord != EEPROM_DATATYPE_MAC)
        {
            EnetAppUtils_print("MAC is not fused in eeprom instance number %d, Invalid typeword %02X\r\n", eepromInstance, (int)typeWord);
            continue;
        }

        /* Both read EEPROM and typeword check is success.
        Now, read MAC Address from EEPROM. */
        int32_t status = EEPROM_read(gEepromHandle[eepromInstance], EEPROM_MAC_ADDR_START,
                                     macAddrBuf, sizeof(macAddrBuf));
        if (status != SystemP_SUCCESS)
        {
            EnetAppUtils_print("Unable to read from eeprom instance number %d\r\n", eepromInstance);
            continue;
        }

        /* Validate the MAC Addresses. */
        if (!IS_MAC_ADDR_VALID(macAddrBuf))
        {
            EnetAppUtils_print("Invalid MAC Address from eeprom instance number %d\r\n", eepromInstance);
            continue;
        }

        /* Copy the MAC address to the output buffer */
        memcpy(macAddr[macFilledCount], macAddrBuf, ENET_MAC_ADDR_LEN);

        macFilledCount += 1;
    }

    *pAvailMacEntries = macFilledCount;
}

#define IO_EXP_ADDR    0x22U

static void EnetBoard_setMacPortIOExpanderCfg(void)
{
    int32_t status;
    /* IO Expander Config Object */
    static TCA6416_Config IOExp_Config;

    TCA6416_Params  IOExp_Params = {
        .i2cInstance = CONFIG_I2C0,
        .i2cAddress  = IO_EXPANDER_1_I2C_ADDR,
    };
    /* open the IO Expander object */
    status = TCA6416_open(&IOExp_Config, &IOExp_Params);

    if (status == SystemP_SUCCESS)
    {
        /* Set the RGMII1 and RGMII2 ports as Outputs. */
        status = TCA6416_config(&IOExp_Config,
            IO_EXPANDER_PHY1_RST_IO_IDX, TCA6416_MODE_OUTPUT);
        status += TCA6416_config(&IOExp_Config,
            IO_EXPANDER_PHY2_RST_IO_IDX, TCA6416_MODE_OUTPUT);
    }

    if (status == SystemP_SUCCESS)
    {
        status = TCA6416_setOutput(&IOExp_Config,
            IO_EXPANDER_PHY1_RST_IO_IDX, TCA6416_OUT_STATE_LOW);
        status += TCA6416_setOutput(&IOExp_Config,
            IO_EXPANDER_PHY2_RST_IO_IDX, TCA6416_OUT_STATE_LOW);
    }

    /* Wait 10us for PHY Reset. */
    ClockP_usleep(10);

    if (status == SystemP_SUCCESS)
    {
        status = TCA6416_setOutput(&IOExp_Config,
            IO_EXPANDER_PHY1_RST_IO_IDX, TCA6416_OUT_STATE_HIGH);
        status += TCA6416_setOutput(&IOExp_Config,
            IO_EXPANDER_PHY2_RST_IO_IDX, TCA6416_OUT_STATE_HIGH);
    }

    TCA6416_close(&IOExp_Config);
    DebugP_assert(status == SystemP_SUCCESS);
}
/*
 * Get ethernet board id
 */
uint32_t EnetBoard_getId(void)
{
    return ENETBOARD_AM275X_EVM;
}

% }
