gpio4.$name        = "CONFIG_GPIO_TX_MCASP";
gpio4.pinDir       = "OUTPUT";
gpio4.GPIO.$assign = "MCASP4_ACLKX";

gpio5.$name        = "CONFIG_GPIO_RX_MCASP";
