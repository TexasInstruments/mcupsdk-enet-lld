<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="C7000"
                deviceId="TMS320C75XX.AM275x"
            />
        </when>
    </applicability>

    <project
        title="Central Ring Audio App"
        name = "central_ring_audio_app_am275x-evm-dp83867_am275x-evm_c75ss0-0_freertos_ti-c7000"
        products="sysconfig;com.ti.MCU_PLUS_SDK_AMXXX"
        configurations="
            Debug,
            Release,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TI"
        cgtVersion=""
        device="TMS320C75XX.AM275x"
        deviceCore=""
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include
            -I${MCU_PLUS_SDK_PATH}/source
            -I$(MCU_PLUS_SDK_PATH)/source/networking/enet/core/examples/tsn/aafpcm_audio_demo/common_files
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/TI_CGT/DSP_C75X
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am275x/c75x
            -I${MCU_PLUS_SDK_PATH}/source/networking/enet/core/examples/tsn/avb_cpsw_app
            -mv7524
            -q
            -mo
            -pden
            -pds=238
            -pds=880
            -pds1110
            --disable_inlining
            -ea.se71
            --emit_warnings_as_errors
            --diag_suppress=770
            --diag_suppress=69
            --diag_suppress=70
            -DBUILD_C7X
            -DBUILD_C7X_1
            -DSOC_AM275X
            -DSOC_AM275X
        "
        linkerBuildOptions="
            -igenerated
            -i${MCU_PLUS_SDK_PATH}/source/kernel/freertos/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/lib
            -i${MCU_PLUS_SDK_PATH}/source/board/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/udma/lib
            -i${MCU_PLUS_SDK_PATH}/source/networking/enet/lib
            -i${MCU_PLUS_SDK_PATH}/source/networking/tsn/lib
            -i${MCU_PLUS_SDK_PATH}/source/networking/tsn/tsn-stack/eval_lib
            -i${MCU_PLUS_SDK_PATH}/source/networking/tsn/tsn-stack/license_lib
            -i${CG_TOOL_ROOT}/lib
            -m=central_ring_audio_app.${ConfigName}.map
            -z
            --emit_warnings_as_errors
            --diag_suppress=10063
            --ram_model
            --warn_sections
            -x
        "

        postBuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} MCU_PLUS_SDK_PATH=${MCU_PLUS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE}"

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --context c75ss0-0 --part AM2754 --package ANJ
        "

        description="A Central Ring Audio App FREERTOS project">

        <configuration name="Debug"
            compilerBuildOptions="
                -Dxdc_target_name__=C71
                -D_DEBUG_=1
                --opt_level=0
                --symdebug:dwarf
            "
            linkerBuildOptions="
                -lfreertos.am275x.c75x.ti-c7000.debug.lib
                -ldrivers.am275x.c75x.ti-c7000.debug.lib
                -ludma.am275x.c75x.ti-c7000.debug.lib
                -llibc.a
            "
        ></configuration>
        <configuration name="Release"
            compilerBuildOptions="
                -Dxdc_target_name__=C71
                --opt_level=3
                --symdebug:none
            "
            linkerBuildOptions="
                -lfreertos.am275x.c75x.ti-c7000.release.lib
                -ldrivers.am275x.c75x.ti-c7000.release.lib
                -ludma.am275x.c75x.ti-c7000.release.lib
                -llibc.a
            "
        ></configuration>
        <pathVariable name="MCU_PLUS_SDK_PATH" path="${COM_TI_MCU_PLUS_SDK_AMXXX_INSTALL_DIR}" scope="project" />
        <file path="../main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../remote_core/remote_mcasp_playback.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/shm_cirbuf.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/gpio_sm.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/gpio_sm.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/shm_cirbuf.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="linker.cmd" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../example.syscfg" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="${MCU_PLUS_SDK_PATH}/docs/api_guide_am275x/EXAMPLES_ENET_AVB_AUDIO_ETHERRING_DEMO.html"
                openOnCreation="false" excludeFromBuild="false" targetName="README.html" action="link">
        </file>
        <file path="syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="makefile_ccs_bootimage_gen" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>
