        <file path="../../../../../common_files/cbs_config.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/Enetapp_common.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../../aafpcm_app/aaf_pcm_app.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/avtpcf.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../../common.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/crf_app.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/crf_hw_config.h" openOnCreation="false" excludeFromBuild="false" action="copy">
