        <file path="../../../../../../enetapp_cpsw.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../common_files/gpio_sm.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../../../../../aafpcm_app/sample_audio.h" openOnCreation="false" excludeFromBuild="false" action="copy">
