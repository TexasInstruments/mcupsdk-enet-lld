enet_cpsw1.RGMII2.TXC.$suggestSolution        = "RGMII1_TXC";
enet_cpsw1.CPSW_CPTS.$suggestSolution         = "CP_GEMAC_CPTS0";
enet_cpsw1.CPSW_CPTS.TS_SYNC.$suggestSolution = "SPI0_CLK";
